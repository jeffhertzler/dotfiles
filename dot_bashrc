# Lightweight Git Bash baseline: no shell framework.
[[ $- == *i* ]] || return 0

# Herdr's Windows preview may omit USER from a new ConPTY environment.
export USER="${USER:-${USERNAME:-$(id -un)}}"

# Do not inherit Codex/Herdr's host-side request to disable terminal color.
unset NO_COLOR

# Native Windows tools needed by Herdr and Neovim.
if [[ -d "$HOME/AppData/Local/Programs/Herdr/bin" ]]; then
  export PATH="$HOME/AppData/Local/Programs/Herdr/bin:$PATH"
fi
if [[ -d "/c/Program Files/LLVM/bin" ]]; then
  export PATH="/c/Program Files/LLVM/bin:$PATH"
fi
if [[ -d "/c/Program Files/starship/bin" ]]; then
  export PATH="/c/Program Files/starship/bin:$PATH"
fi
export PATH="$HOME/.opencode/bin:$PATH"

# Load the Bash line editor early, then attach it after prompt configuration.
if [[ -r "$HOME/.local/share/blesh/ble.sh" ]]; then
  source -- "$HOME/.local/share/blesh/ble.sh" --attach=none
fi

# Persistent, deduplicated history.
HISTFILE="$HOME/.bash_history"
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize cmdhist autocd

# Match the preferred modal editing behavior from Zsh.
set -o vi

[[ -r "$HOME/.config/shell/common.sh" ]] && source "$HOME/.config/shell/common.sh"

# Bash-specific editing and reload helpers.
alias be='nvim ~/.bashrc'
alias reload='exec bash -l'

# Fast directory jumping and a shared cross-shell prompt.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Native Windows cannot reliably inspect Git Bash's logical cwd after `cd`.
# Report it through OSC 7 so Herdr can refresh workspace Git metadata.
__herdr_report_cwd() {
  [[ -n ${HERDR_PANE_ID-} ]] || return

  local windows_path uri_path character escape
  local LC_ALL=C encoded= index
  windows_path=$(cygpath -m -- "$PWD") || return
  uri_path="/$windows_path"

  for ((index = 0; index < ${#uri_path}; index++)); do
    character=${uri_path:index:1}
    case $character in
    [-A-Za-z0-9._~/:])
      encoded+=$character
      ;;
    *)
      printf -v escape '%%%02X' "'$character"
      encoded+=$escape
      ;;
    esac
  done

  printf '\033]7;file://%s\033\\' "$encoded"
}

if [[ -n ${HERDR_PANE_ID-} ]]; then
  if [[ ${BLE_VERSION-} ]]; then
    blehook PRECMD+='__herdr_report_cwd'
  else
    PROMPT_COMMAND+=(__herdr_report_cwd)
  fi
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach

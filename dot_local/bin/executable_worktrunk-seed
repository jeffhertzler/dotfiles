#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: worktrunk-seed --source DIR --destination DIR \
  [--copy PATH]... [--symlink PATH]...

Copy or symlink selected paths from a primary checkout into a worktree.
Existing copied paths are preserved, and existing expected symlinks are reused.
Other symlink conflicts are errors.
EOF
  exit 2
}

source_root=
destination_root=
declare -a copy_paths=()
declare -a symlink_paths=()

while (($#)); do
  case $1 in
    --source)
      (($# >= 2)) || usage
      source_root=$2
      shift 2
      ;;
    --destination)
      (($# >= 2)) || usage
      destination_root=$2
      shift 2
      ;;
    --copy)
      (($# >= 2)) || usage
      copy_paths+=("$2")
      shift 2
      ;;
    --symlink)
      (($# >= 2)) || usage
      symlink_paths+=("$2")
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      printf 'worktrunk-seed: unknown argument: %s\n' "$1" >&2
      usage
      ;;
  esac
done

[[ -n $source_root && -n $destination_root ]] || usage
source_root=$(cd -- "$source_root" && pwd -P)
destination_root=$(cd -- "$destination_root" && pwd -P)

if [[ $source_root == "$destination_root" ]]; then
  printf 'source and destination are the same checkout; nothing to seed\n'
  exit 0
fi

validate_relative_path() {
  case $1 in
    ""|/*|..|../*|*/..|*/../*)
      printf 'worktrunk-seed: unsafe relative path: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

source_exists() {
  [[ -e $1 || -L $1 ]]
}

for relative_path in "${copy_paths[@]}"; do
  validate_relative_path "$relative_path"
  source_path=$source_root/$relative_path
  destination_path=$destination_root/$relative_path

  if ! source_exists "$source_path"; then
    printf 'worktrunk-seed: copy source is missing; skipping %s\n' "$relative_path" >&2
    continue
  fi
  if source_exists "$destination_path"; then
    printf 'copy destination already exists; preserving %s\n' "$relative_path"
    continue
  fi

  mkdir -p -- "$(dirname -- "$destination_path")"
  cp -a -- "$source_path" "$destination_path"
  printf 'copied %s\n' "$relative_path"
done

for relative_path in "${symlink_paths[@]}"; do
  validate_relative_path "$relative_path"
  source_path=$source_root/$relative_path
  destination_path=$destination_root/$relative_path

  if ! source_exists "$source_path"; then
    printf 'worktrunk-seed: symlink source is missing; skipping %s\n' "$relative_path" >&2
    continue
  fi
  if [[ -L $destination_path && $(readlink -- "$destination_path") == "$source_path" ]]; then
    printf 'already linked %s\n' "$relative_path"
    continue
  fi
  if source_exists "$destination_path"; then
    printf 'worktrunk-seed: destination already exists: %s\n' "$destination_path" >&2
    exit 1
  fi

  mkdir -p -- "$(dirname -- "$destination_path")"
  ln -s -- "$source_path" "$destination_path"
  printf 'linked %s\n' "$relative_path"
done

#!/bin/sh

mode=${1:-}
[ "$#" -gt 0 ] && shift

log_file="${XDG_RUNTIME_DIR:-/tmp}/lazygit-nvim.log"
server=
launcher_kind=standalone
launcher_buf=

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$log_file"
}

usage() {
  log "invalid invocation mode=${mode:-<none>} args=$*"
  exit 1
}

case "$mode" in
edit | dir)
  [ "$#" -eq 1 ] || usage "$@"
  ;;
line | wait)
  [ "$#" -eq 2 ] || usage "$@"
  ;;
*)
  usage "$@"
  ;;
esac

live_nvim_server() {
  [ -n "$1" ] && nvim --headless --server "$1" --remote-expr 'v:servername' >/dev/null 2>&1
}

resolve_herdr_target() {
  herdr_pane=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}
  [ -n "$herdr_pane" ] || return 1

  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    registry_dir=$XDG_RUNTIME_DIR/herdr-nvim
  elif [ "${OS:-}" = Windows_NT ]; then
    registry_dir=${TMPDIR:-/tmp}/herdr-nvim
  else
    registry_dir=/tmp/herdr-nvim-$(id -u)
  fi

  safe_pane=$(printf '%s' "$herdr_pane" | tr -c 'A-Za-z0-9_.-' '_')
  registry_file=$registry_dir/$safe_pane.server
  [ -r "$registry_file" ] || return 1

  IFS= read -r candidate <"$registry_file" || candidate=
  if live_nvim_server "$candidate"; then
    server=$candidate
    launcher_kind=herdr_popup
    return 0
  fi

  rm -f "$registry_file"
  return 1
}

resolve_tmux_target() {
  candidate=$("$HOME/.local/bin/tmux-nvim-server" 2>/dev/null) || candidate=
  [ -n "$candidate" ] || return 1

  server=$candidate
  launcher_kind=tmux_popup
}

resolve_target() {
  if [ -n "${NVIM:-}" ]; then
    server=$NVIM
    launcher_kind=nvim_terminal
    return
  fi

  resolve_herdr_target && return
  resolve_tmux_target || true
}

open_local_editor() {
  case "$mode" in
  edit | dir)
    exec nvim -- "$1"
    ;;
  line | wait)
    exec nvim "+$1" -- "$2"
    ;;
  esac
}

nvim_rpc() {
  nvim --headless --server "$server" "$@"
}

open_in_target() {
  case "$mode" in
  edit | dir)
    nvim_rpc --remote "$1"
    ;;
  line | wait)
    nvim_rpc --remote "$2" && nvim_rpc --remote-send "<cmd>$1<cr>"
    ;;
  esac
}

capture_launcher_state() {
  [ "$launcher_kind" = nvim_terminal ] || return
  launcher_buf=$(nvim_rpc --remote-expr 'bufnr()' 2>/dev/null) || launcher_buf=
  log "Neovim terminal buf=${launcher_buf:-<none>}"
}

close_nvim_terminal() {
  case "$launcher_buf" in
  '' | *[!0-9]*)
    log "skip Neovim terminal close invalid_buf=${launcher_buf:-<none>}"
    return
    ;;
  esac

  nvim_rpc --remote-expr \
    "luaeval(\"require('config.lazygit').close_terminal(_A)\", $launcher_buf)" \
    >/dev/null 2>&1 && log "queued Neovim terminal close buf=$launcher_buf" || log "failed Neovim terminal close buf=$launcher_buf"
}

close_herdr_popup() {
  log "close Herdr popup target=${HERDR_ACTIVE_PANE_ID:-<none>}"
  if command -v node >/dev/null 2>&1 && node "$HOME/.local/bin/herdr-popup-close.mjs" >/dev/null 2>&1; then
    log "sent Herdr popup close"
  else
    log "failed Herdr popup close"
  fi
}

close_tmux_popup() {
  log "close tmux popup target=${TMUX_NVM_TARGET:-<none>}"
  [ -n "${TMUX_NVM_TARGET:-}" ] || return
  tmux run-shell -b "sleep 0.1; tmux display-popup -C >/dev/null 2>&1 || true" >/dev/null 2>&1
}

close_launcher() {
  case "$launcher_kind" in
  nvim_terminal)
    close_nvim_terminal
    ;;
  herdr_popup)
    close_herdr_popup
    ;;
  tmux_popup)
    close_tmux_popup
    ;;
  esac
}

resolve_target
log "mode=$mode server=${server:-<none>} launcher=$launcher_kind pane=${TMUX_PANE:-<none>} popup=${TMUX_POPUP_PANE:-<none>} tmux_target=${TMUX_NVM_TARGET:-<none>} herdr_target=${HERDR_ACTIVE_PANE_ID:-<none>} args=$*"

if [ -z "$server" ]; then
  open_local_editor "$@"
fi

capture_launcher_state
open_in_target "$@"
status=$?

if [ "$status" -eq 0 ]; then
  close_launcher
fi

exit "$status"

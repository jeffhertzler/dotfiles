#!/usr/bin/env bash
set -euo pipefail

if [[ ${HERDR_ENV:-} == 1 ]]; then
  printf 'Detach from the current Herdr session first, then run hs again.\n' >&2
  exit 1
fi

if (($# > 1)); then
  printf 'usage: herdr-session-picker [session]\n' >&2
  exit 2
fi

if (($# == 1)); then
  exec herdr --session "$1"
fi

selection=$(
  herdr session list --json |
    jq -r '.sessions[] | [.name, (if .running then "running" else "stopped" end), (if .default then "default" else "" end)] | @tsv' |
    fzf \
      --delimiter=$'\t' \
      --with-nth=1,2,3 \
      --prompt='Herdr session › ' \
      --header='Enter: attach · Esc: cancel' \
      --layout=reverse \
      --border
) || exit 0

session=${selection%%$'\t'*}
[[ -n $session ]] || exit 0
exec herdr session attach "$session"

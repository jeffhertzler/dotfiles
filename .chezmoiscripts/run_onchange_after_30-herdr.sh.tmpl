{{- $profile := includeTemplate "profile" . | trim -}}
{{- if ne $profile "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

# Automatic refresh date: {{ now | date "2006-01-02" }}

if ! command -v herdr >/dev/null 2>&1; then
  echo "Herdr reconciliation requires herdr on PATH" >&2
  exit 1
fi

{{ range .herdrIntegrations -}}
integration={{ . | quote }}
echo "Installing or updating Herdr integration $integration"
herdr integration install "$integration"

{{ end -}}
{{ range .herdrPlugins -}}
plugin_id={{ .id | quote }}
plugin_source={{ .source | quote }}
{{ if get . "managedRepo" -}}
node "$HOME/.local/bin/herdr-plugin-reconcile.mjs" \
  --id "$plugin_id" \
  --path "$HOME/{{ .managedLink }}" \
  --origin-url {{ printf "git@github.com:%s.git" .managedRepo | quote }} \
  --upstream-url {{ printf "https://github.com/%s.git" .source | quote }} \
  --ref {{ .managedRef | quote }}
{{ else -}}
plugin_json=$(herdr plugin list --plugin "$plugin_id" --json)
plugin_present=false
if printf '%s' "$plugin_json" | grep -Fq "\"plugin_id\":\"$plugin_id\""; then
  plugin_present=true
fi

echo "Updating Herdr plugin $plugin_id from $plugin_source"
if ! herdr plugin install "$plugin_source" --yes; then
  if [[ $plugin_present == false ]]; then
    echo "Could not install required Herdr plugin $plugin_id" >&2
    exit 1
  fi
  echo "Could not update $plugin_id; keeping the installed copy" >&2
fi

plugin_json=$(herdr plugin list --plugin "$plugin_id" --json)
if ! printf '%s' "$plugin_json" | grep -Fq '"enabled":true'; then
  echo "Enabling Herdr plugin $plugin_id"
  herdr plugin enable "$plugin_id"
fi
{{ end }}

{{ end -}}
# A running server picks up the new registry immediately. No server is also a
# valid state during bootstrap, so a reload failure is intentionally harmless.
herdr server reload-config >/dev/null 2>&1 || true
{{- end }}

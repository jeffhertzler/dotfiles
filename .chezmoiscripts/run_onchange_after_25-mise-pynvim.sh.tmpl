{{- $profile := includeTemplate "profile" . | trim -}}
{{- if ne $profile "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v mise >/dev/null 2>&1; then
  echo "The Neovim Python provider bootstrap requires mise on PATH" >&2
  exit 1
fi

# Mise's pipx backend uses uv, but a newly installed uv may still resolve
# through Mise's recursive shim in this process. Bootstrap uv first, then put
# its concrete installation directory ahead of the shims for the pipx install.
mise install uv
uv_path=$(mise which uv)
PATH="$(dirname "$uv_path"):$PATH" mise install uv pipx:pynvim
mise reshim
{{- end }}

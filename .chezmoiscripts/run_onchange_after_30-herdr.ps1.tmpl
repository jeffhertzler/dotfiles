{{- $profile := includeTemplate "profile" . | trim -}}
{{- if eq $profile "windows" -}}
$ErrorActionPreference = "Stop"

# Automatic refresh date: {{ now | date "2006-01-02" }}

$herdr = Get-Command herdr -ErrorAction SilentlyContinue
if (-not $herdr) {
  throw "Herdr reconciliation requires herdr on PATH"
}

{{ range .herdrIntegrations -}}
$integration = {{ . | quote }}
if (-not (Get-Command $integration -ErrorAction SilentlyContinue)) {
  Write-Warning "Skipping Herdr integration $integration because its executable is not installed"
} else {
  Write-Output "Installing or updating Herdr integration $integration"
  & $herdr.Source integration install $integration
  if ($LASTEXITCODE -ne 0) { throw "Failed to install Herdr integration $integration" }
}

{{ end -}}
$node = Get-Command node -ErrorAction SilentlyContinue
if (-not $node) {
  throw "Herdr plugin reconciliation requires node on PATH"
}
$reconciler = Join-Path $HOME ".local/bin/herdr-plugin-reconcile.mjs"
if (-not (Test-Path -LiteralPath $reconciler -PathType Leaf)) {
  throw "Herdr plugin reconciler is missing: $reconciler"
}

{{ range .herdrPlugins -}}
& $node.Source $reconciler `
  --id {{ .id | quote }} `
  --path (Join-Path $HOME {{ .windowsLink | quote }}) `
  --origin-url {{ printf "git@github.com:%s.git" .windowsRepo | quote }} `
  --upstream-url {{ printf "https://github.com/%s.git" .source | quote }} `
  --ref {{ .windowsRef | quote }}
if ($LASTEXITCODE -ne 0) {
  throw "Failed to reconcile Herdr plugin {{ .id }}"
}

{{ end -}}
# A running server picks up the new registry immediately. No server is also a
# valid state during bootstrap, so a reload failure is intentionally harmless.
$null = & $herdr.Source server reload-config 2>$null
exit 0
{{- end }}

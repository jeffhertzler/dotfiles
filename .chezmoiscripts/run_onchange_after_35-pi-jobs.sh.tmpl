{{- $profile := includeTemplate "profile" . | trim -}}
{{- if eq $profile "arch" -}}
#!/usr/bin/env bash
set -euo pipefail

systemctl --user daemon-reload
systemctl --user enable herdr.service

# Avoid starting a second server while an older, manually launched Herdr server
# owns the default socket. Herdr status exits zero even when no server is running,
# so inspect the structured liveness field.
status=$(herdr --session default status server --json 2>/dev/null || true)
if ! jq -e '.running == true' <<<"$status" >/dev/null 2>&1; then
  systemctl --user start herdr.service
fi
{{- end }}

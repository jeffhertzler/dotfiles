{{- $profile := includeTemplate "profile" . | trim -}}
onboarding = false

{{ if eq $profile "windows" -}}
[terminal]
default_shell = "C:/Program Files/Git/bin/bash.exe"
new_cwd = "follow"

[update]
channel = "preview"

{{ end -}}
[ui.sidebar.spaces]
rows = [["state_icon", "workspace"], ["$session", "branch", "git_status"]]

[experimental]
kitty_graphics = true
pane_history = true

[theme]
name = "catppuccin"
auto_switch = true
light_name = "catppuccin-latte"
dark_name = "catppuccin"


[keys]
prefix = "ctrl+a"
previous_workspace = "prefix+k"
next_workspace = "prefix+j"
switch_workspace = "prefix+shift+1..9"
previous_tab = "prefix+h"
next_tab = "prefix+l"
focus_pane_left = ""
focus_pane_down = ""
focus_pane_up = ""
focus_pane_right = ""
navigate_workspace_up = "k"
navigate_workspace_down = "j"
navigate_pane_left = "ctrl+h"
navigate_pane_down = "ctrl+j"
navigate_pane_up = "ctrl+k"
navigate_pane_right = "ctrl+l"
swap_pane_left = "prefix+shift+h"
swap_pane_down = "prefix+shift+j"
swap_pane_up = "prefix+shift+k"
swap_pane_right = "prefix+shift+l"
split_vertical = "prefix+alt+l"
split_horizontal = "prefix+alt+j"

[[keys.command]]
key = "prefix+alt+h"
type = "shell"
command = "~/.local/bin/herdr-directional-split.mjs local left"
description = "split pane left"

[[keys.command]]
key = "prefix+alt+k"
type = "shell"
command = "~/.local/bin/herdr-directional-split.mjs local up"
description = "split pane up"

{{ if eq $profile "arch" -}}
[[keys.command]]
key = "prefix+p"
type = "popup"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-popup-picker"
description = "open popup launcher"
width = "90%"
height = "90%"

[[keys.command]]
key = "prefix+ctrl+h"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-reorder.mjs tab left"
description = "move tab left"

[[keys.command]]
key = "prefix+ctrl+l"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-reorder.mjs tab right"
description = "move tab right"

[[keys.command]]
key = "prefix+ctrl+k"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-reorder.mjs workspace up"
description = "move workspace / worktree group up"

[[keys.command]]
key = "prefix+ctrl+j"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-reorder.mjs workspace down"
description = "move workspace / worktree group down"

[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "worktrunk.open"
description = "worktree: switch / create from default branch"

[[keys.command]]
key = "prefix+ctrl+g"
type = "plugin_action"
command = "worktrunk.open-current"
description = "worktree: switch / create from current branch"

[[keys.command]]
key = "prefix+ctrl+x"
type = "plugin_action"
command = "worktrunk.remove"
description = "worktree: remove with hooks"

[[keys.command]]
key = "ctrl+h"
type = "plugin_action"
command = "herdr-splits.nav-left"
description = "navigate left (neovim/herdr)"

[[keys.command]]
key = "ctrl+j"
type = "plugin_action"
command = "herdr-splits.nav-down"
description = "navigate down (neovim/herdr)"

[[keys.command]]
key = "ctrl+k"
type = "plugin_action"
command = "herdr-splits.nav-up"
description = "navigate up (neovim/herdr)"

[[keys.command]]
key = "ctrl+l"
type = "plugin_action"
command = "herdr-splits.nav-right"
description = "navigate right (neovim/herdr)"

[[keys.command]]
key = "alt+h"
type = "plugin_action"
command = "herdr-splits.resize-left"
description = "resize left (neovim/herdr)"

[[keys.command]]
key = "alt+j"
type = "plugin_action"
command = "herdr-splits.resize-down"
description = "resize down (neovim/herdr)"

[[keys.command]]
key = "alt+k"
type = "plugin_action"
command = "herdr-splits.resize-up"
description = "resize up (neovim/herdr)"

[[keys.command]]
key = "alt+l"
type = "plugin_action"
command = "herdr-splits.resize-right"
description = "resize right (neovim/herdr)"

[[keys.command]]
key = "prefix+alt+shift+h"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-directional-split.mjs full left"
description = "split full-height pane left"

[[keys.command]]
key = "prefix+alt+shift+j"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-directional-split.mjs full down"
description = "split full-width pane down"

[[keys.command]]
key = "prefix+alt+shift+k"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-directional-split.mjs full up"
description = "split full-width pane up"

[[keys.command]]
key = "prefix+alt+shift+l"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-directional-split.mjs full right"
description = "split full-height pane right"
{{ end -}}

{{- $profile := includeTemplate "profile" . | trim -}}
[settings]
idiomatic_version_file_enable_tools = ["java", "node", "python"]

[settings.java]
shorthand_vendor = "temurin"

[settings.go]
set_gobin = false

[settings.node]
corepack = true

[tools]
go = "latest"
node = "lts"
python = "latest"
uv = "latest"
"npm:@earendil-works/pi-coding-agent" = "latest"
"npm:neovim" = "latest"
"pipx:pynvim" = { version = "latest", depends = ["uv"] }
{{- if eq $profile "windows" }}
"github:tree-sitter/tree-sitter" = { version = "v0.26.11", bin = "tree-sitter.exe" }
{{- else if eq $profile "wsl" }}
"github:jesseduffield/lazygit" = "latest"
"github:tree-sitter/tree-sitter" = "v0.26.11"
rust = "stable"
chezmoi = "2.71.1"
{{- else if or (eq $profile "macos") (eq $profile "arch") }}
java = ["17", "11"]
maven = "latest"
{{- end }}

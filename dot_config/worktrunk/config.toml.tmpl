{{- $profile := includeTemplate "profile" . | trim -}}
{{- $wtOpen := "{{" -}}
{{- $wtClose := "}}" -}}
# Keep the sibling directory layout used by workmux.
worktree-path = "{{ $wtOpen }} repo_path {{ $wtClose }}/../{{ $wtOpen }} repo {{ $wtClose }}__worktrees/{{ $wtOpen }} branch | sanitize {{ $wtClose }}"

# herdr-worktrunk 0.4 expects Worktrunk's original bare-array JSON output.
[list]
json-schema = 1
{{ if eq $profile "arch" }}
[pre-remove]
opencode = "sh -lc 'oc-cleanup kill >/dev/null 2>&1 || true'"

# Personal setup for Ultralight. Keeping this in Worktrunk's user config makes
# it available from every checkout without committing project configuration.
[[projects."github.com/stingerlabs/ultralight".pre-start]]
seed = """
worktrunk-seed \
  --source {{ $wtOpen }} primary_worktree_path {{ $wtClose }} \
  --destination {{ $wtOpen }} worktree_path {{ $wtClose }} \
  --copy .env \
  --symlink .cursor/mcp.json \
  --symlink .mcp.json \
  --symlink .opencode \
  --symlink .pi/settings.json \
  --symlink .redwood \
  --symlink node_modules \
  --symlink api/node_modules \
  --symlink api/types/graphql.d.ts \
  --symlink web/node_modules \
  --symlink web/types/graphql.d.ts \
  --symlink AGENTS.md \
  --symlink CLAUDE.md \
  --symlink opencode.jsonc
"""

[[projects."github.com/stingerlabs/ultralight".pre-start]]
environment = "node scripts/local/worktree/sync-env.mjs"

[projects."github.com/stingerlabs/ultralight".pre-remove]
cleanup = "WM_WORKTREE_PATH={{ $wtOpen }} worktree_path {{ $wtClose }} WM_PROJECT_ROOT={{ $wtOpen }} primary_worktree_path {{ $wtClose }} node scripts/local/worktree/cleanup.mjs"
{{ end -}}

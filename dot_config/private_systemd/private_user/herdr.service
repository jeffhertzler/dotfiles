[Unit]
Description=Herdr persistent terminal workspace server
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr-service-supervisor
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=45
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target

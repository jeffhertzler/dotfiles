{{- $profile := includeTemplate "profile" . | trim -}}
[mgr]
show_hidden = true

[tasks]
suppress_preload = true

[opener]
nvim = [
  { run = '~/.config/yazi/nvim-remote.sh "$@"', desc = "Open in Neovim", block = true, for = "unix" },
]
{{- if eq $profile "macos" }}
open = [{ run = 'open "$@"', desc = "Open with system handler" }]
{{- else }}
open = [{ run = 'xdg-open "$@"', desc = "Open with system handler" }]
{{- end }}

[open]
rules = [
  # Text files
  { mime = "text/*", use = "nvim" },
  { mime = "application/json", use = "nvim" },
  { mime = "application/javascript", use = "nvim" },
  { mime = "application/x-yaml", use = "nvim" },

  # Configuration files
  { url = "*.conf", use = "nvim" },
  { url = "*.config", use = "nvim" },
  { url = "*.toml", use = "nvim" },
  { url = "*.yaml", use = "nvim" },
  { url = "*.yml", use = "nvim" },
  { url = "*.json", use = "nvim" },
  { url = "*.js", use = "nvim" },
  { url = "*.ts", use = "nvim" },
  { url = "*.md", use = "nvim" },
  { url = "*.txt", use = "nvim" },
  { url = "*.log", use = "nvim" },

  # Shell scripts
  { url = "*.sh", use = "nvim" },
  { url = "*.bash", use = "nvim" },
  { url = "*.zsh", use = "nvim" },

  # Programming files
  { url = "*.py", use = "nvim" },
  { url = "*.rs", use = "nvim" },
  { url = "*.go", use = "nvim" },
  { url = "*.c", use = "nvim" },
  { url = "*.cpp", use = "nvim" },
  { url = "*.h", use = "nvim" },
  { url = "*.hpp", use = "nvim" },

  # Dotfiles
  { url = ".*rc", use = "nvim" },
  { url = ".*profile", use = "nvim" },
  { url = ".*env", use = "nvim" },

  # Fallback for everything else
  { url = "*", use = ["nvim", "open"] },
]

#!/usr/bin/env zsh

export BUN_INSTALL="$HOME/.bun"
export VOLTA_HOME="$HOME/.volta"
export COMPOSER_BIN="$HOME/.config/composer/vendor/bin"
export GOPATH="$HOME/go"

# Herdr's noninteractive SSH bridge may not receive a client locale.
export LANG="${LANG:-en_US.UTF-8}"

# Stop Mise at the Linux and mounted Windows home boundaries when a WSL shell
# starts beneath a Windows-hosted project. This must apply to noninteractive
# shells as well as terminals.
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
  export MISE_CEILING_PATHS="$HOME:/mnt/c/Users/Jeff Hertzler"
fi

path=(
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"
  "$HOME/.local/share/mise/shims"
  "$VOLTA_HOME/bin"
  "$HOME/.local/bin"
  "$HOME/.atuin/bin"
  "$HOME/.opencode/bin"
  "$BUN_INSTALL/bin"
  "$HOME/.cargo/bin"
  "$HOME/.go/bin"
  "$GOPATH/bin"
  "$COMPOSER_BIN"
  $path
)

typeset -U path PATH
export PATH

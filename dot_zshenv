#!/usr/bin/env zsh

export BUN_INSTALL="$HOME/.bun"
export VOLTA_HOME="$HOME/.volta"
export COMPOSER_BIN="$HOME/.config/composer/vendor/bin"

# Herdr's noninteractive SSH bridge may not receive a client locale.
export LANG="${LANG:-en_US.UTF-8}"

path=(
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"
  # During the staged Node migration, untouched package.json.volta projects
  # keep using Volta. `mise activate zsh` places an active project's concrete
  # Mise tool paths ahead of both entries when that project has migrated.
  "$VOLTA_HOME/bin"
  "$HOME/.local/share/mise/shims"
  "$HOME/.local/bin"
  "$HOME/.atuin/bin"
  "$HOME/.opencode/bin"
  "$BUN_INSTALL/bin"
  "$HOME/.cargo/bin"
  "$HOME/go/bin"
  "$COMPOSER_BIN"
  $path
)

typeset -U path PATH
export PATH

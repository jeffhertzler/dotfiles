{
  "style": {
    "position": "footer",
    "overflow": "truncate",
    "renderer": "{{ .chezmoi.homeDir }}/.pi/agent/renderers/pi-info-responsive.mjs"
  },
  "segments": {
    "model": {
      "color": "syntaxVariable"
    },
    "branch": {
      "color": "mdLinkUrl"
    },
    "cwd": {
      "color": "dim"
    },
    "billing": {
      "color": "mdCode"
    },
    "cache": {
      "color": "syntaxOperator"
    },
    "io": {
      "color": "toolTitle"
    },
    "extensions": {
      "format": "{text}",
      "color": "text"
    }
  }
}

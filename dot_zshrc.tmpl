{{- $profile := includeTemplate "profile" . | trim -}}
#!/usr/bin/env zsh

# Let ez-compinit reuse its completion cache for up to 20 hours. Antidote's
# plugin list owns compinit, so do not initialize it a second time here.
zstyle ':plugin:ez-compinit' use-cache on

if [[ -r /usr/share/zsh-antidote/antidote.zsh ]]; then
  source /usr/share/zsh-antidote/antidote.zsh
  antidote load
elif [[ -r "$HOME/.antidote/antidote.zsh" ]]; then
  source "$HOME/.antidote/antidote.zsh"
  antidote load
fi

setopt AUTO_CD
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

[[ -r "$HOME/.config/shell/common.sh" ]] && source "$HOME/.config/shell/common.sh"

# Activate machine-managed development tools before testing optional commands.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

alias au="antidote update"

# Put the named Herdr session in each workspace's sidebar metadata.
if [[ "$HERDR_ENV" == "1" && -n "$HERDR_SESSION" && -n "$HERDR_WORKSPACE_ID" ]]; then
  command herdr workspace report-metadata "$HERDR_WORKSPACE_ID" \
    --source shell:session --token "session=$HERDR_SESSION" \
    --seq "$(date +%s)" >/dev/null 2>&1 &!
fi

if command -v zoxide >/dev/null 2>&1 && [[ "$CLAUDECODE" != "1" ]]; then
  alias cd="z"
fi

alias ve="nvim ~/.local/share/chezmoi/dot_config/nvim"
alias ze="chezmoi edit ~/.zshrc"

alias reload="source ~/.zshrc"

alias sail="./vendor/bin/sail"
{{ if or (eq $profile "wsl") (eq $profile "macos") }}
# Herdr clients for the Arch host. SSH owns direct versus Tailscale routing.
function ha() {
  command herdr --remote arch --remote-keybindings server "$@"
}

function hat() {
  command herdr --remote archt --remote-keybindings server "$@"
}
{{ end }}
F=~/.private.zsh; [ -f $F ] && . $F
{{- if eq $profile "wsl" }}
F=~/.wsl.zsh; [ -f $F ] && . $F
{{- else if eq $profile "arch" }}
F=~/.arch.zsh; [ -f $F ] && . $F
{{- else if eq $profile "macos" }}
F=~/.mac.zsh; [ -f $F ] && . $F
{{- end }}
F=~/.config/shell/greenlight.zsh; [ -f $F ] && . $F
F=~/.config/shell/vimme.zsh; [ -f $F ] && . $F
F=~/.bun/_bun; [ -f $F ] && . $F

if command -v op >/dev/null 2>&1; then
  eval "$(op completion zsh)"
  (( $+functions[compdef] )) && compdef _op op
fi

if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi

if command -v starship >/dev/null 2>&1 && (( ! $+functions[starship_zle-keymap-select] )); then
  eval "$(starship init zsh)"
fi

function zvm_after_init() {
  if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh)"
  fi
  if command -v zoxide >/dev/null 2>&1 && [[ "$CLAUDECODE" != "1" ]]; then
    _ZO_DOCTOR=0
    eval "$(zoxide init zsh)"
  fi
}

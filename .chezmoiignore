{{- $profile := includeTemplate "profile" . | trim -}}
README.md
.config/git/local.config

{{- if ne (env "CHEZMOI_INCLUDE_SECRETS") "1" }}
.private.zsh
.ssh/id_rsa
{{- end }}

# WSL and native Windows begin deny-by-default. Their files will be enabled
# one reviewed layer at a time instead of inheriting the existing Unix setup.
{{- if or (eq $profile "wsl") (eq $profile "windows") (eq $profile "linux") (eq $profile "unsupported") }}
.agents
.config/*
!.config/git
!.config/git/config
!.config/git/ignore
!.config/starship.toml
!.config/shell
!.config/shell/common.sh
.greenlight.zsh
.jabba
.local
.ocprofile.zsh
.pi
.private.zsh
.profile
.ssh
.vimme.zsh
.zsh_plugins.txt
ensure-herdr-plugins.sh
{{- end }}

# Native Windows uses Git Bash; the Unix profiles use Zsh.
{{- if ne $profile "windows" }}
.bash_profile
.bashrc
{{- end }}

{{- if or (eq $profile "windows") (eq $profile "linux") (eq $profile "unsupported") }}
.zshenv
.zshrc
{{- end }}

# WSL-only bridge and remote-session helpers.
{{- if ne $profile "wsl" }}
.wsl.zsh
{{- end }}

# Each Unix system gets only its own profile overlay.
{{- if ne $profile "arch" }}
.arch.zsh
{{- end }}

{{- if ne $profile "macos" }}
.mac.zsh
{{- end }}

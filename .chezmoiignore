{{- end }}

# Native Windows uses Git Bash; the Unix profiles use Zsh.
{{- if ne $profile "windows" }}
.bash_profile
.bashrc
{{- end }}

{{- if or (eq $profile "windows") (eq $profile "linux") (eq $profile "unsupported") }}
.zshenv
.zshrc
{{- end }}

# WSL-only bridge and remote-session helpers.
{{- if ne $profile "wsl" }}
.wsl.zsh
{{- end }}

# Each Unix system gets only its own profile overlay.
{{- if ne $profile "arch" }}
.arch.zsh
{{- end }}

{{- if ne $profile "macos" }}
.mac.zsh
{{- end }}

# Arch owns the workstation helper collection, but not the client-side tunnel.
{{- if eq $profile "arch" }}
.local/bin/tunnel
{{- end }}

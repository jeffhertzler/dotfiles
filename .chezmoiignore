.agents
.config/*
!.config/git
!.config/git/config
!.config/git/ignore
{{- if or (eq $profile "wsl") (eq $profile "macos") (eq $profile "windows") }}
!.config/lazygit
!.config/lazygit/config.yml
!.config/herdr
.config/herdr/*
!.config/herdr/config.toml
{{- end }}
{{- if or (eq $profile "wsl") (eq $profile "windows") }}
!.config/nvim
!.config/nvim/**
{{- end }}
{{- if or (eq $profile "wsl") (eq $profile "macos") }}
!.config/gh
.config/gh/*
!.config/gh/config.yml
{{- end }}
{{- if eq $profile "wsl" }}
!.config/opencode
!.config/opencode/**
{{- end }}
{{- if eq $profile "macos" }}
!.config/atuin
!.config/atuin/**
!.config/bat
!.config/bat/**
!.config/bottom
!.config/bottom/bottom.toml
!.config/lazydocker
!.config/lazydocker/config.yml
!.config/posting
!.config/posting/config.yaml
!.config/tmux
!.config/tmux/**
!.config/workmux
!.config/workmux/config.yaml
!.config/yazi
!.config/yazi/**
{{- end }}
!.config/starship.toml
!.config/shell
!.config/shell/common.sh
.greenlight.zsh
.jabba
{{- if or (eq $profile "wsl") (eq $profile "macos") }}

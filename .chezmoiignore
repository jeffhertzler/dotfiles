{{- $profile := includeTemplate "profile" . | trim -}}
README.md
docs
packages
.config/git/local.config
.config/nvim/lazy-lock.json

{{- if ne (env "CHEZMOI_INCLUDE_SECRETS") "1" }}
.private.zsh
.ssh/id_rsa
.ssh/id_rsa.pub
{{- end }}

# Generic Linux and unknown platforms are not supported profiles yet.
{{- if or (eq $profile "linux") (eq $profile "unsupported") }}
*
{{- else }}

# Native Windows uses Git Bash; WSL, macOS, and Arch share Zsh.
{{- if eq $profile "windows" }}
.zshenv
.zshrc
.zsh_plugins.txt
.config/shell/greenlight.zsh
.config/shell/vimme.zsh
{{- else }}
.bash_profile
.bashrc
{{- end }}

# Each Unix profile receives only its own overlay.
{{- if ne $profile "wsl" }}
.wsl.zsh
{{- end }}
{{- if ne $profile "macos" }}
.mac.zsh
{{- end }}
{{- if ne $profile "arch" }}
.arch.zsh
{{- end }}

# Arch retains the legacy workstation and tmux/Workmux configuration.
{{- if ne $profile "arch" }}
.config/tmux
.config/workmux
.local/bin/tmux-lazygit-popup
.local/bin/tmux-nvim-server
.local/bin/tmux-preview-update
.local/bin/tmux-yazi-split
.local/bin/worktrunk-seed
{{- end }}

# LazyDocker and Posting are workstation applications on macOS and Arch.
{{- if not (or (eq $profile "macos") (eq $profile "arch")) }}
.config/lazydocker
.config/posting
{{- end }}

# The client-side tunnel has separate WSL and macOS implementations.
{{- if not (or (eq $profile "wsl") (eq $profile "macos")) }}
.local/bin/tunnel
{{- end }}
{{- end }}

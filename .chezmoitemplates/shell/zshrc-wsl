# Lightweight zsh baseline: Antidote plugins, no shell framework.

# Let ez-compinit reuse its completion cache for up to 20 hours.
zstyle ':plugin:ez-compinit' use-cache on

# Antidote plugin manager. Prefer a distro package path when available,
# otherwise use the upstream checkout in ~/.antidote.
if [[ -r /usr/share/zsh-antidote/antidote.zsh ]]; then
  source /usr/share/zsh-antidote/antidote.zsh
  antidote load
elif [[ -r "$HOME/.antidote/antidote.zsh" ]]; then
  source "$HOME/.antidote/antidote.zsh"
  antidote load
fi

# Useful interactive behavior.
setopt AUTO_CD
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# Native persistent history.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

[[ -r "$HOME/.config/shell/common.sh" ]] && source "$HOME/.config/shell/common.sh"

# Zsh-specific editing and reload helpers.
alias ze='nvim ~/.zshrc'
alias reload='source ~/.zshrc'

# Development tool and runtime versions.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Keep WSL-specific additions separate from the baseline.
[[ -r "$HOME/.wsl.zsh" ]] && source "$HOME/.wsl.zsh"

if command -v starship >/dev/null 2>&1 && (( ! $+functions[starship_zle-keymap-select] )); then
  eval "$(starship init zsh)"
fi

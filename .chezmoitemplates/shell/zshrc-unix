{{- $profile := includeTemplate "profile" . | trim -}}
#!/usr/bin/env zsh

# Let ez-compinit reuse its completion cache for up to 20 hours. Antidote's
# plugin list owns compinit, so do not initialize it a second time here.
zstyle ':plugin:ez-compinit' use-cache on

if [[ -r /usr/share/zsh-antidote/antidote.zsh ]]; then
  source /usr/share/zsh-antidote/antidote.zsh
  antidote load
elif [[ -r "$HOME/.antidote/antidote.zsh" ]]; then
  source "$HOME/.antidote/antidote.zsh"
  antidote load
fi

setopt AUTO_CD
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

[[ -r "$HOME/.config/shell/common.sh" ]] && source "$HOME/.config/shell/common.sh"

# Activate machine-managed development tools before testing optional commands.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

alias au="antidote update"
alias gou="SHELL_PROFILE=/tmp/go-installer-profile bash <(curl -sL https://git.io/go-installer)"

function piu() {
  if command -v mise >/dev/null 2>&1; then
    command mise upgrade 'npm:@earendil-works/pi-coding-agent' --minimum-release-age 0s
  elif command -v volta >/dev/null 2>&1; then
    command volta install @earendil-works/pi-coding-agent@latest
  else
    print -u2 "piu: neither mise nor volta is available"
    return 127
  fi
}

if command -v uv >/dev/null 2>&1; then
  alias uvu="uv tool upgrade --all"
fi

if command -v herdr-session-picker >/dev/null 2>&1; then
  alias hs="herdr-session-picker"
fi
alias rmrf="rm -rf"

# Put the named Herdr session in each workspace's sidebar metadata.
if [[ "$HERDR_ENV" == "1" && -n "$HERDR_SESSION" && -n "$HERDR_WORKSPACE_ID" ]]; then
  command herdr workspace report-metadata "$HERDR_WORKSPACE_ID" \
    --source shell:session --token "session=$HERDR_SESSION" \
    --seq "$(date +%s)" >/dev/null 2>&1 &!
fi

function rcu() {
  if command -v rustup >/dev/null 2>&1; then
    command rustup update
  fi
  if command -v cargo-install-update >/dev/null 2>&1; then
    command cargo install-update --all
  fi
}

if command -v zoxide >/dev/null 2>&1 && [[ "$CLAUDECODE" != "1" ]]; then
  alias cd="z"
fi

alias cm="chezmoi"

if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
fi

alias gb="git branch"
alias gbd="git branch -D"

alias gco="git checkout"
alias gcob="git checkout -b"
alias gcod="git checkout develop"
alias gcom="git checkout main"

alias gc="git commit"
alias gci="git commit --allow-empty -m 'ci: bump'"
alias gcm="git commit -m"

alias gcp="git cherry-pick"

alias gl="git pull"
alias gp="git push"

if command -v lazydocker >/dev/null 2>&1; then
  alias lad="lazydocker"
fi

if command -v eza >/dev/null 2>&1; then
  alias ls="eza"
  alias la="eza -laag --icons"
  alias lt="eza -T --icons"
fi

{{- if eq $profile "arch" }}
alias ta="tmux a"
{{- end }}

if command -v posting >/dev/null 2>&1; then
  alias pe="nvim ~/.local/share/posting/default"
fi
{{- if eq $profile "arch" }}
alias te="nvim ~/.local/share/chezmoi/dot_config/tmux/tmux.conf"
{{- end }}
alias ve="nvim ~/.local/share/chezmoi/dot_config/nvim"
alias ze="chezmoi edit ~/.zshrc"

alias reload="source ~/.zshrc"

alias sail="./vendor/bin/sail"

{{- if eq $profile "arch" }}
alias tsd="sudo tailscale down"
alias tsu="sudo tailscale up --accept-dns --accept-routes"
{{- end }}

if command -v cursor-agent >/dev/null 2>&1; then
  alias ca="cursor-agent --yolo"
fi
{{- if eq $profile "arch" }}
alias wm='workmux'
{{- end }}

if command -v yazi >/dev/null 2>&1; then
  function y() {
	  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	  yazi "$@" --cwd-file="$tmp"
	  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		  builtin cd -- "$cwd"
	  fi
	  rm -f -- "$tmp"
  }
fi

F=~/.private.zsh; [ -f $F ] && . $F
{{- if eq $profile "wsl" }}
F=~/.wsl.zsh; [ -f $F ] && . $F
{{- else if eq $profile "arch" }}
F=~/.arch.zsh; [ -f $F ] && . $F
{{- else if eq $profile "macos" }}
F=~/.mac.zsh; [ -f $F ] && . $F
{{- end }}
F=~/.greenlight.zsh; [ -f $F ] && . $F
F=~/.vimme.zsh; [ -f $F ] && . $F
F=~/.ocprofile.zsh; [ -f $F ] && . $F
F=~/.jabba/jabba.sh; [ -f $F ] && . $F
F=~/.bun/_bun; [ -f $F ] && . $F

if (( $+functions[oc] )); then
  alias ocp="oc -P personal"
  alias ocw="oc -P work"
fi

if command -v op >/dev/null 2>&1; then
  eval "$(op completion zsh)"
  (( $+functions[compdef] )) && compdef _op op
fi

{{- if eq $profile "arch" }}
if command -v workmux >/dev/null 2>&1; then
  eval "$(workmux completions zsh)"
fi
{{- end }}

if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi

if command -v starship >/dev/null 2>&1 && (( ! $+functions[starship_zle-keymap-select] )); then
  eval "$(starship init zsh)"
fi

function zvm_after_init() {
  if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh)"
  fi
  if command -v zoxide >/dev/null 2>&1 && [[ "$CLAUDECODE" != "1" ]]; then
    _ZO_DOCTOR=0
    eval "$(zoxide init zsh)"
  fi
}
